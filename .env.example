GCP_PROJECT_ID=your-project-id-here
GCS_BUCKET_NAME=your-bucket-name-here
# Raw landing dataset: loaders write here, dbt reads it as a source.
BIGQUERY_RAW_DATASET=raw
# Base dataset for the dbt prod target (dbt builds satellite_analytics_<layer>).
BIGQUERY_DATASET=satellite_analytics
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# dbt (all optional; defaults shown)
BIGQUERY_LOCATION=US
DBT_DEV_DATASET=dbt_dev
DBT_TARGET=dev
